// Shared, frozen interfaces for every moon-slice package.
// Do not edit this file in a mission worktree; propose a contract change instead.

///|
pub(all) struct Loc {
  start_line : Int32
  start_col : Int32
  end_line : Int32
  end_col : Int32
} derive(Debug, Eq, Hash)

///|
pub(all) enum SNodeKind {
  Let
  LetMut
  Assign
  If
  While
  For
  Match
  Return
  Break
  Continue
  Call
  Expr
} derive(Debug, Eq)

///|
pub(all) struct VarId {
  name : String
  scope : Int32
} derive(Debug, Eq, Hash)

///|
pub(all) struct SNode {
  id : Int32
  kind : SNodeKind
  loc : Loc
  defs : Array[VarId]
  uses : Array[VarId]
  children : Array[Int32]
  parent : Int32?
} derive(Debug)

///|
pub(all) struct FunctionInfo {
  name : String
  entry : Int32
  exit : Int32
} derive(Debug)

///|
pub(all) struct Program {
  nodes : Array[SNode]
  functions : Array[FunctionInfo]
  errors : Array[String]
} derive(Debug)

///|
pub(all) struct Cfg {
  edges : Array[(Int32, Int32)]
  entry : Int32
  exit : Int32
} derive(Debug)

///|
pub(all) struct DefUse {
  // (definition node id, use node id)
  reaching : Array[(Int32, Int32)]
} derive(Debug)

///|
pub(all) struct Cdg {
  // (controller node id, controlled node id)
  edges : Array[(Int32, Int32)]
} derive(Debug)

///|
pub(all) enum EdgeKind {
  Data
  Control
} derive(Debug, Eq)

///|
pub(all) struct PdgEdge {
  from : Int32
  to : Int32
  kind : EdgeKind
} derive(Debug)

///|
pub(all) struct Pdg {
  edges : Array[PdgEdge]
} derive(Debug)

///|
pub(all) enum SliceDirection {
  Backward
  Forward
} derive(Debug, Eq)

///|
pub(all) struct SliceResult {
  nodes : Array[Int32]
  lines : Array[Int32]
} derive(Debug)
